# ==========================================
# LIFE//OS Environment Variables Configuration
# ==========================================
# Copy this file to .env.local and populate with your credentials.

# 1. Supabase Database & Project API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
SUPABASE_SECRET_KEY=your-supabase-service-role-or-secret-key

# 2. Direct PostgreSQL Connection (Used for running migrations & schema setup)
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# 3. Custom Auth Security Architecture Secret (Required - fail-closed)
# Must be a cryptographically strong 32+ character string
LIFEOS_SESSION_SECRET=replace_with_a_secure_random_64_char_hex_secret
